---
// 通用能力卡：icon + title + description
export interface Props {
  icon: string; // emoji or short symbol
  title: string;
  description: string;
  tags?: string[];
}

const { icon, title, description, tags = [] } = Astro.props;
---

<article
  class="card-warm rounded-[var(--radius-lg)] p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-warm)] group"
>
  <div
    class="w-12 h-12 rounded-[var(--radius-md)] grid place-items-center bg-gradient-to-br from-[color:var(--color-cream-200)] to-[color:var(--color-cream-300)] text-2xl mb-4 group-hover:scale-110 transition-transform"
  >
    {icon}
  </div>
  <h3 class="text-lg font-semibold text-[color:var(--color-ink-300)] mb-2">{title}</h3>
  <p class="text-sm text-[color:var(--color-ink-50)] leading-relaxed">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-[color:var(--color-cream-200)] text-[color:var(--color-ink-50)]">
            {t}
          </span>
        ))}
      </div>
    )
  }
</article>
