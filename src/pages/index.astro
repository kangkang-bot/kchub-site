---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CapabilityCard from '../components/CapabilityCard.astro';
import { SITE } from '../consts';

const capabilities = [
  {
    icon: '🧭',
    title: '调研 & 攻略',
    description:
      '把"想了解 XX 主题"或"想去 XX 玩"的需求交给它。它拆解任务、查资料、写报告，最终给你一份能看完的简报。',
    tags: ['Research', 'Report', 'Export'],
  },
  {
    icon: '🗂️',
    title: '家庭数据中枢',
    description:
      '把日程、待办、纪念日、账本、阅读清单存到一处。所有数据有主人、有边界——Kang 的归 Kang，Chen 的归 Chen。',
    tags: ['Isolated', 'Sharing'],
  },
  {
    icon: '💬',
    title: '评论 & 修复',
    description:
      '在报告旁留下评注，点一下"让它改一下"，它就回查上下文、改稿、回写——一个会自我修复的小宇宙。',
    tags: ['Feedback Loop', 'Self-healing'],
  },
  {
    icon: '🪄',
    title: '小工具积木',
    description:
      '每一个小功能都是一块独立的积木——查天气、追 GitHub 趋势、生成早报、安排约会。想加新的？加块新积木就行。',
    tags: ['Modular', 'Extensible'],
  },
  {
    icon: '🔐',
    title: '数据安心',
    description:
      '数据可以只留在家里那台 Mac mini 上，也可以走云端。所有外部访问都加密，只有你和我能看。',
    tags: ['Encrypted', 'Private'],
  },
  {
    icon: '📱',
    title: '多端入口',
    description:
      '小程序、Web、机器人——在哪儿都能下指令。任务回到家里那台电脑执行，结果推回当前设备。',
    tags: ['Miniapp', 'Web', 'Bot'],
  },
];
---

<BaseLayout>
  <!-- ============================================ Hero -->
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-b from-[color:var(--color-cream-200)]/40 via-transparent to-transparent pointer-events-none"
    >
    </div>

    <!-- 装饰元素：柔和的暖光圈 -->
    <div
      class="absolute -top-32 -right-24 w-96 h-96 rounded-full bg-[color:var(--color-peach-300)]/30 blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-20 w-96 h-96 rounded-full bg-[color:var(--color-rose-300)]/25 blur-3xl pointer-events-none"
    >
    </div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 sm:pt-32 pb-16 sm:pb-24">
      <div class="max-w-3xl">
        <p
          class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-peach-500)] mb-5 px-3 py-1.5 rounded-full bg-[color:var(--color-cream-200)]/80 border border-[color:var(--color-line-200)]"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-peach-400)] animate-breathe"></span>
          家庭项目 · {SITE.since}
        </p>

        <h1
          class="text-4xl sm:text-6xl font-semibold tracking-tight text-[color:var(--color-ink-300)] leading-[1.1]"
        >
          我们的<span class="text-warm-gradient">家庭数字中枢</span>，<br
            class="hidden sm:block"
          />由 KCHub 编织。
        </h1>

        <p
          class="mt-6 text-lg sm:text-xl text-[color:var(--color-ink-50)] leading-relaxed max-w-2xl"
        >
          KCHub 是 Kang 和 Chen 的家庭数字中枢——
          把调研、攻略、日程、纪念日、待办、评论都交给一个会自我修复的小宇宙。<br
            class="hidden sm:block"
          />我们只负责提需求，AI 负责把它们变成能读、能改、能分享的内容。
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/capabilities"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium bg-[color:var(--color-ink-200)] text-[color:var(--color-cream-50)] hover:bg-[color:var(--color-peach-500)] transition-colors shadow-[var(--shadow-soft)]"
          >
            看看 KCHub 能做什么
            <span>→</span>
          </a>
          <a
            href="/architecture"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium bg-[color:var(--color-cream-50)] text-[color:var(--color-ink-200)] border border-[color:var(--color-line-200)] hover:border-[color:var(--color-peach-400)] hover:text-[color:var(--color-peach-500)] transition-colors"
          >
            它是怎么搭起来的
          </a>
        </div>
      </div>

      <!-- 模拟一段 chat 演示 -->
      <div
        class="mt-16 max-w-3xl card-warm rounded-[var(--radius-xl)] p-5 sm:p-7 bg-grid-soft"
      >
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-[color:var(--color-peach-400)]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[color:var(--color-rose-300)]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[color:var(--color-cream-400)]"></span>
          <span class="ml-3 text-xs text-[color:var(--color-ink-50)] font-mono">kchub / conversation</span>
        </div>
        <div class="space-y-3 font-mono text-sm">
          <div class="flex gap-3">
            <span class="text-[color:var(--color-peach-500)]">Kang →</span>
            <span class="text-[color:var(--color-ink-200)]">"下个月去京都自由行 5 天，预算 1.5 万，做个攻略"</span>
          </div>
          <div class="flex gap-3">
            <span class="text-[color:var(--color-rose-400)]">KCHub →</span>
            <span class="text-[color:var(--color-ink-100)]">"已接单。准备调取：景点 · 交通 · 住宿 · 餐厅 · 天气。预计 6 分钟出报告。"</span>
          </div>
          <div class="flex gap-3">
            <span class="text-[color:var(--color-ink-50)]">[ 02:14 后 ]</span>
            <span class="text-[color:var(--color-ink-50)]">报告已生成 → 京都 5 日攻略</span>
          </div>
          <div class="flex gap-3">
            <span class="text-[color:var(--color-peach-500)]">Chen →</span>
            <span class="text-[color:var(--color-ink-200)]">"Day3 走太多路了吧，重新排一下"</span>
          </div>
          <div class="flex gap-3">
            <span class="text-[color:var(--color-rose-400)]">KCHub →</span>
            <span class="text-[color:var(--color-ink-100)]">"收到，重新平衡 Day3 步行强度 ↻"</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ 核心能力 -->
  <Section
    eyebrow="Capabilities"
    title="六块拼图，组成我们家的小宇宙"
    subtitle="每块都独立可拆，也互相咬合。"
  >
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => <CapabilityCard {...c} />)}
    </div>
  </Section>

  <!-- ============================================ 流程 -->
  <Section
    eyebrow="How it works"
    title="从一句「想研究 XX」到一份能用的报告"
    subtitle="触发方式很轻，执行过程很重。"
    className="bg-[color:var(--color-cream-50)] border-y border-[color:var(--color-line-200)]"
  >
    <div class="mt-14 max-w-4xl mx-auto">
      <ol class="grid gap-4 sm:gap-0 sm:grid-cols-4 sm:items-stretch relative">
        <!-- 连接线 -->
        <div
          class="hidden sm:block absolute top-7 left-[12.5%] right-[12.5%] h-px bg-gradient-to-r from-[color:var(--color-peach-400)] via-[color:var(--color-rose-300)] to-[color:var(--color-peach-400)] opacity-50"
        >
        </div>

        {[
          { n: '01', t: '提需求', d: '小程序 / Web / 机器人对话' },
          { n: '02', t: '任务到家里那台电脑', d: '它醒过来开始干活' },
          { n: '03', t: '查资料 + 写报告', d: '调研、写作、排版' },
          { n: '04', t: '报告回到你手里', d: '可以评注 · 可以让它改' },
        ].map((s) => (
          <li class="relative">
            <div
              class="card-warm rounded-[var(--radius-md)] p-5 h-full bg-[color:var(--color-cream-50)]"
            >
              <div
                class="w-12 h-12 rounded-full grid place-items-center bg-gradient-to-br from-[color:var(--color-peach-400)] to-[color:var(--color-rose-400)] text-white font-semibold text-sm mb-3 shadow-[var(--shadow-warm)]"
              >
                {s.n}
              </div>
              <h3 class="font-semibold text-[color:var(--color-ink-300)] mb-1">{s.t}</h3>
              <p class="text-xs text-[color:var(--color-ink-50)] leading-relaxed">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-12 text-center">
      <a
        href="/architecture"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-peach-500)] hover:text-[color:var(--color-peach-600)]"
      >
        看完整架构图 <span>→</span>
      </a>
    </div>
  </Section>

  <!-- ============================================ CTA -->
  <section class="py-20">
    <div
      class="max-w-4xl mx-auto px-5 sm:px-8 card-warm rounded-[var(--radius-2xl)] p-10 sm:p-14 text-center bg-gradient-to-br from-[color:var(--color-cream-50)] via-[color:var(--color-cream-100)] to-[color:var(--color-cream-200)]"
    >
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[color:var(--color-ink-300)] mb-4">
        把那些<span class="text-warm-gradient">半夜冒出来的研究欲</span><br
          class="hidden sm:block"
        />交给 KCHub 吧
      </h2>
      <p class="text-[color:var(--color-ink-50)] max-w-xl mx-auto leading-relaxed">
        你说一声"想研究 XX"，AI 就去查资料、写报告、排版、推给你看。<br
          class="hidden sm:block"
        />你只管在茶歇时翻一翻，签字画押也行。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium bg-[color:var(--color-ink-200)] text-[color:var(--color-cream-50)] hover:bg-[color:var(--color-peach-500)] transition-colors"
        >
          给我们留言
        </a>
        <a
          href="/roadmap"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium bg-transparent text-[color:var(--color-ink-200)] border border-[color:var(--color-line-200)] hover:border-[color:var(--color-peach-400)]"
        >
          看看做到哪儿了
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
